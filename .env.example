# =============================================================================
# Variables d'environnement du portfolio — copier ce fichier en `.env`
# (ne JAMAIS committer `.env`). Les variables marquées (optionnel) peuvent
# rester vides en dev : l'application se dégrade proprement (SPEC §1).
# =============================================================================

# --- Base de données (obligatoire) -------------------------------------------
# Dev local : URL TCP affichée par `npm run db:start` (Prisma Postgres local,
# commande `prisma dev`). Prod : URL Neon (avec ?sslmode=require).
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"
# Base « fantôme » utilisée par `prisma migrate dev` (dev uniquement).
# Prisma Postgres local en expose une sur le port suivant.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# --- Auth.js (obligatoire) -----------------------------------------------------
# Secret de chiffrement des JWT. Générer avec : npx auth secret
# ou : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# GitHub OAuth (optionnel) : si absent, le bouton « Se connecter avec GitHub » est masqué.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Emails Resend (optionnel) -------------------------------------------------
# Si absent : les messages de contact sont enregistrés en BDD et loggés en console.
RESEND_API_KEY=""
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_TO_EMAIL="albangrelaud@proton.me"

# --- Cloudinary (optionnel) ----------------------------------------------------
# Si absent : l'admin peut coller une URL d'image à la place de l'upload.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Cloudflare Turnstile (optionnel en dev, obligatoire en prod) -------------
# Si absent en dev : les clés de test Cloudflare (toujours valides) sont utilisées.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Compte administrateur (utilisé UNIQUEMENT par `npm run db:seed`) ---------
ADMIN_EMAIL="albangrelaud@proton.me"
# Mot de passe initial (10 à 128 caractères). À changer après la 1re connexion.
ADMIN_INITIAL_PASSWORD=""

# --- Site ----------------------------------------------------------------------
# URL publique canonique (sitemap, robots, Open Graph). Sans slash final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
